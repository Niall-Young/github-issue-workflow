{
  "manifestVersion": 2,
  "id": "issue-autopilot",
  "name": "Orca Autopilot",
  "version": "0.2.3",
  "description": "Orca 的 GitHub Issue 自动驾驶插件：状态栏展示待处理徽标，点击或快捷键一键在终端打开纯 TUI 控制台。",
  "license": "MIT",
  "repository": "https://github.com/Niall-Young/orca-autopilot",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "main": "orca-plugin/src/worker.ts",
  "pluginApi": 1,
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "terminal:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" }
  ],
  "contributes": {
    "commands": [
      {
        "id": "open-autopilot",
        "title": "在终端打开当前项目的 Orca Autopilot 控制台 (TUI)"
      }
    ],
    "keybindings": [
      {
        "command": "open-autopilot",
        "key": "Mod+Shift+I"
      }
    ],
    "statusBarItems": [
      {
        "id": "autopilot-status",
        "text": "Autopilot",
        "icon": "terminal",
        "tone": "neutral",
        "tooltip": "在终端打开当前项目的 Orca Autopilot 控制台 (TUI)",
        "command": "open-autopilot"
      }
    ],
    "events": [
      { "on": "agent.status.changed" },
      { "on": "workspace.changed" }
    ]
  }
}
