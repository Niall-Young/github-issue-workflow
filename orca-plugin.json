{
  "manifestVersion": 2,
  "id": "issue-autopilot",
  "name": "Orca Autopilot",
  "version": "0.2.4",
  "description": "Autopiloto de GitHub Issues para Orca: insignia de pendientes en barra de estado y consola TUI interactiva.",
  "license": "MIT",
  "repository": "https://github.com/Niall-Young/orca-autopilot",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "main": "orca-plugin/src/worker.ts",
  "pluginApi": 1,
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "terminal:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" }
  ],
  "contributes": {
    "commands": [
      {
        "id": "open-autopilot",
        "title": "Abrir consola Orca Autopilot del proyecto actual (TUI)"
      }
    ],
    "keybindings": [
      {
        "command": "open-autopilot",
        "key": "Mod+Shift+I"
      }
    ],
    "statusBarItems": [
      {
        "id": "autopilot-status",
        "text": "Autopilot",
        "icon": "rocket",
        "tone": "neutral",
        "tooltip": "Abrir consola Orca Autopilot del proyecto actual (TUI)",
        "command": "open-autopilot"
      }
    ],
    "events": [
      { "on": "agent.status.changed" },
      { "on": "workspace.changed" }
    ]
  }
}
