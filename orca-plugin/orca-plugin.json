{
  "manifestVersion": 2,
  "id": "issue-board",
  "name": "Issue 看板",
  "version": "0.2.1",
  "description": "面向终端的轻量 Issue 看板：在 Orca 状态栏展示待处理徽标，点击或快捷键一键在终端打开纯 TUI 看板。",
  "license": "MIT",
  "repository": "https://github.com/Niall-Young/github-issue-workflow",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "main": "src/worker.ts",
  "pluginApi": 1,
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "terminal:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" }
  ],
  "contributes": {
    "commands": [
      {
        "id": "open-board",
        "title": "在终端打开当前项目的 Issue 看板 (TUI)"
      }
    ],
    "keybindings": [
      {
        "command": "open-board",
        "key": "Mod+Shift+I"
      }
    ],
    "statusBarItems": [
      {
        "id": "board-status",
        "text": "Issue 看板",
        "icon": "terminal",
        "tone": "neutral",
        "tooltip": "在终端打开当前项目的 Issue 看板 (TUI)",
        "command": "open-board"
      }
    ],
    "events": [
      { "on": "agent.status.changed" },
      { "on": "workspace.changed" }
    ]
  }
}
