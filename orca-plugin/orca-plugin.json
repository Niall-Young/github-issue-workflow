{
  "manifestVersion": 2,
  "id": "issue-board",
  "name": "Issue 看板",
  "version": "0.1.0",
  "description": "面向非开发者的项目级 Issue 仪表盘：提需求、看结果、只在需要时回复问题或确认。",
  "license": "MIT",
  "repository": "https://github.com/Niall-Young/github-issue-workflow",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "main": "src/worker.ts",
  "pluginApi": 1,
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:read" },
    { "kind": "terminal:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" },
    { "kind": "storage:own" }
  ],
  "contributes": {
    "customEditors": [
      {
        "id": "issue-board",
        "title": "Issue 看板",
        "extensions": [
          ".issue-board"
        ],
        "entry": "editor/main.ts",
        "priority": "default",
        "frame": "isolated"
      }
    ],
    "commands": [
      {
        "id": "open-board",
        "title": "打开当前项目的 Issue 看板"
      }
    ],
    "keybindings": [
      {
        "command": "open-board",
        "key": "Mod+Shift+I"
      }
    ],
    "statusBarItems": [
      {
        "id": "board-status",
        "text": "Issue 看板",
        "icon": "layers",
        "tone": "neutral",
        "tooltip": "打开当前项目的 Issue 看板",
        "command": "open-board"
      }
    ],
    "events": [
      { "on": "agent.status.changed" },
      { "on": "workspace.changed" }
    ]
  }
}
