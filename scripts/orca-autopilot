#!/usr/bin/env python3
"""One-command terminal TUI launcher and standalone installer for Orca Autopilot."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PLUGIN_DIR = REPO_ROOT
TUI_ENTRY = REPO_ROOT / "orca-plugin" / "src" / "tui" / "app.ts"
DEFAULT_INSTALL_DIR = Path.home() / ".local" / "share" / "orca-autopilot"
DEFAULT_PLUGIN_KEY = "local.issue-autopilot"
DEFAULT_RELEASE_REPO = "Niall-Young/orca-autopilot"
FULL_BUNDLE_PREFIX = "github-issue-workflow-full-"
CLI_NAMES = ("orca-autopilot", "orca-board")
MANAGED_SKILLS = (
    "github-issue-handoff",
    "github-issue-repair",
    "github-issue-autopilot",
    "github-issue-workflow-update",
)
AGENT_SKILL_ROOTS: tuple[tuple[Path, Path], ...] = (
    (Path(".claude"), Path(".claude") / "skills"),
    (Path(".codex"), Path(".codex") / "skills"),
    (Path(".agents"), Path(".agents") / "skills"),
    (Path(".gemini") / "antigravity-cli", Path(".gemini") / "antigravity-cli" / "skills"),
)
COPY_IGNORE = shutil.ignore_patterns(
    ".orca",
    "node_modules",
    "__pycache__",
    "*.pyc",
    "*.pyo",
    ".DS_Store",
)


def run_cmd(cmd: list[str], cwd: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=cwd,
        text=True,
        capture_output=True,
        check=False,
    )


def resolve_project_root(target: Path, runner=run_cmd) -> Path:
    res = runner(["git", "rev-parse", "--show-toplevel"], cwd=str(target))
    if res.returncode == 0 and res.stdout.strip():
        return Path(res.stdout.strip()).resolve()
    return target.resolve()


def resolve_tui_runtime(which=shutil.which) -> list[str]:
    bun = which("bun")
    if bun:
        return [bun]
    node = which("node")
    if node:
        return [node]
    raise RuntimeError("未找到 bun 或 node 运行时，请先安装 bun 或 Node.js >= 22。")


def build_tui_command(
    target: Path,
    tui_entry: Path = TUI_ENTRY,
    runner=run_cmd,
    which=shutil.which,
) -> list[str]:
    if not target.exists():
        raise RuntimeError(f"目录不存在：{target}")
    if not tui_entry.exists():
        raise RuntimeError(f"未找到终端 TUI 入口：{tui_entry}")
    root = resolve_project_root(target, runner=runner)
    runtime = resolve_tui_runtime(which=which)
    return [*runtime, str(tui_entry), str(root)]


def _copy_dir_clean(src: Path, dst: Path) -> None:
    if dst.is_symlink() or dst.is_file():
        dst.unlink()
    elif dst.exists():
        shutil.rmtree(dst)
    shutil.copytree(src, dst, ignore=COPY_IGNORE)


def install_standalone_files(
    source_root: Path = REPO_ROOT,
    install_dir: Path | None = None,
) -> Path:
    """Copy runtime files into an independent directory so the source checkout can be deleted."""
    target_dir = (install_dir or DEFAULT_INSTALL_DIR).expanduser().resolve()
    src_root = source_root.resolve()
    if target_dir == src_root:
        return target_dir

    target_dir.mkdir(parents=True, exist_ok=True)

    manifest_src = src_root / "orca-plugin.json"
    if not manifest_src.is_file():
        raise RuntimeError(f"未找到插件清单：{manifest_src}")
    shutil.copy2(manifest_src, target_dir / "orca-plugin.json")

    plugin_src = src_root / "orca-plugin"
    if not plugin_src.is_dir():
        raise RuntimeError(f"未找到插件源码目录：{plugin_src}")
    _copy_dir_clean(plugin_src, target_dir / "orca-plugin")

    script_src = src_root / "scripts" / "orca-autopilot"
    if not script_src.is_file():
        raise RuntimeError(f"未找到启动脚本：{script_src}")
    scripts_dst = target_dir / "scripts"
    scripts_dst.mkdir(parents=True, exist_ok=True)
    script_dst = scripts_dst / "orca-autopilot"
    shutil.copy2(script_src, script_dst)
    script_dst.chmod(0o755)

    for skill in MANAGED_SKILLS:
        skill_src = src_root / skill
        if (skill_src / "SKILL.md").is_file():
            _copy_dir_clean(skill_src, target_dir / skill)

    return target_dir


def detect_skill_dirs(home: Path | None = None) -> list[Path]:
    """Detect existing Agent runtime skill directories; fall back to ~/.agents/skills."""
    base = (home or Path.home()).expanduser()
    detected: list[Path] = []
    for marker_rel, skills_rel in AGENT_SKILL_ROOTS:
        if (base / marker_rel).exists():
            detected.append(base / skills_rel)
    if not detected:
        detected.append(base / ".agents" / "skills")
    return detected


def install_skills(
    source_root: Path = REPO_ROOT,
    skill_dirs: list[Path] | None = None,
    home: Path | None = None,
) -> dict[Path, list[str]]:
    """Automatically install all bundled Skills into detected (or specified) Agent skill directories."""
    src_root = source_root.resolve()
    missing = [s for s in MANAGED_SKILLS if not (src_root / s / "SKILL.md").is_file()]
    if missing:
        raise RuntimeError(f"安装包缺少内置 Skill：{', '.join(missing)}")

    targets = [p.expanduser() for p in skill_dirs] if skill_dirs else detect_skill_dirs(home=home)
    installed: dict[Path, list[str]] = {}
    for target_root in targets:
        target_root.mkdir(parents=True, exist_ok=True)
        copied: list[str] = []
        for skill in MANAGED_SKILLS:
            src = (src_root / skill).resolve()
            dst = (target_root / skill).resolve()
            if src != dst:
                _copy_dir_clean(src, target_root / skill)
            copied.append(skill)
        installed[target_root] = copied
    return installed


def find_plugin(runner=run_cmd) -> tuple[dict | None, str | None]:
    res = runner(["orca", "plugin", "list", "--json"])
    if res.returncode != 0:
        return None, (res.stderr.strip() or res.stdout.strip() or "orca plugin list failed")
    try:
        data = json.loads(res.stdout)
    except json.JSONDecodeError as exc:
        return None, str(exc)

    plugins = data.get("result", {}).get("plugins", [])
    fallback = None
    for plugin in plugins:
        key = plugin.get("pluginKey", "")
        if key == DEFAULT_PLUGIN_KEY:
            return plugin, None
        if key.endswith(".issue-autopilot") and fallback is None:
            fallback = plugin
    return fallback, None


def extract_fingerprint(text: str) -> str | None:
    match = re.search(r"Fingerprint:\s*(\S+)", text)
    if match:
        return match.group(1)
    match = re.search(r"--approve\s+(\S+)", text)
    return match.group(1) if match else None


def prompt_for_approval(plugin_key: str, fingerprint: str, input_fn=input) -> bool:
    print(f"首次使用（或插件权限更新后）需要授权 Orca Autopilot 插件（{plugin_key}）。")
    try:
        answer = input_fn("按回车确认授权，输入 n 取消 [Y/n]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer in ("", "y", "yes")


def _run_with_approval(
    base_cmd: list[str],
    plugin_key: str,
    action_label: str,
    *,
    runner=run_cmd,
    is_tty: bool,
    input_fn=input,
) -> subprocess.CompletedProcess[str]:
    res = runner(base_cmd)
    if res.returncode == 0:
        return res
    combined = f"{res.stdout}\n{res.stderr}"
    fp = extract_fingerprint(combined)
    if fp:
        if is_tty:
            if not prompt_for_approval(plugin_key, fp, input_fn=input_fn):
                raise RuntimeError("已取消插件授权。")
            res = runner([*base_cmd, "--approve", fp])
        else:
            cmd_str = " ".join([*base_cmd, "--approve", fp])
            raise RuntimeError(f"插件尚未授权，请在终端运行：\n  {cmd_str}")
    if res.returncode != 0:
        raise RuntimeError(f"{action_label}失败：{res.stderr.strip() or res.stdout.strip()}")
    return res


def ensure_plugin_ready(
    plugin_dir: Path = PLUGIN_DIR,
    runner=run_cmd,
    is_tty: bool | None = None,
    input_fn=input,
    *,
    dev_mode: bool = False,
) -> str:
    if is_tty is None:
        is_tty = sys.stdin.isatty()

    plugin, err = find_plugin(runner=runner)
    if err:
        runner(["orca", "open"])
        plugin, err = find_plugin(runner=runner)
        if err:
            raise RuntimeError(f"无法连接 Orca，请确认 Orca 已打开：{err}")

    bundled_version = json.loads((plugin_dir / "orca-plugin.json").read_text())["version"]

    if dev_mode:
        if plugin is None or (plugin.get("isDev") and plugin.get("version") != bundled_version):
            _run_with_approval(
                ["orca", "plugin", "dev", "load", str(plugin_dir)],
                DEFAULT_PLUGIN_KEY,
                "加载开发插件",
                runner=runner,
                is_tty=is_tty,
                input_fn=input_fn,
            )
            plugin, err = find_plugin(runner=runner)
            if err or plugin is None:
                raise RuntimeError(f"加载插件后仍未找到 {DEFAULT_PLUGIN_KEY}")
    else:
        if plugin is not None and plugin.get("isDev"):
            runner(["orca", "plugin", "dev", "unload", plugin.get("pluginKey") or DEFAULT_PLUGIN_KEY])
            plugin = None

        _run_with_approval(
            ["orca", "plugin", "install", str(plugin_dir)],
            DEFAULT_PLUGIN_KEY,
            "安装插件",
            runner=runner,
            is_tty=is_tty,
            input_fn=input_fn,
        )
        plugin, err = find_plugin(runner=runner)
        if err or plugin is None:
            raise RuntimeError(f"安装插件后仍未找到 {DEFAULT_PLUGIN_KEY}")

    plugin_key = plugin.get("pluginKey") or DEFAULT_PLUGIN_KEY
    status = plugin.get("status")
    needs_reconsent = bool(plugin.get("needsReconsent"))
    if status not in ("running", "idle") or needs_reconsent:
        _run_with_approval(
            ["orca", "plugin", "enable", plugin_key],
            plugin_key,
            "启用插件",
            runner=runner,
            is_tty=is_tty,
            input_fn=input_fn,
        )

    return plugin_key


def install_cli(
    bin_dir: Path | None = None,
    script_path: Path | None = None,
    names: tuple[str, ...] = CLI_NAMES,
) -> list[Path]:
    target_bin = (bin_dir or (Path.home() / ".local" / "bin")).expanduser()
    source = (script_path or Path(__file__)).resolve()
    target_bin.mkdir(parents=True, exist_ok=True)

    installed: list[Path] = []
    for name in names:
        link_path = target_bin / name
        if link_path.is_symlink() or link_path.exists():
            link_path.unlink()
        link_path.symlink_to(source)
        installed.append(link_path)
    return installed


def launch_tui(target: Path) -> int:
    cmd = build_tui_command(target)
    proc = subprocess.run(cmd, check=False)
    return proc.returncode


def read_installed_version(root: Path = REPO_ROOT) -> str | None:
    manifest = root / "orca-plugin.json"
    if not manifest.is_file():
        return None
    try:
        version = json.loads(manifest.read_text(encoding="utf-8")).get("version")
        return str(version).strip() if version else None
    except (OSError, json.JSONDecodeError):
        return None


def _http_get_bytes(url: str, *, timeout: int = 30) -> bytes:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https":
        raise RuntimeError(f"仅允许通过 HTTPS 下载更新包：{url}")
    headers = {
        "User-Agent": "orca-autopilot-cli",
        "Accept": "application/vnd.github+json" if parsed.hostname == "api.github.com" else "*/*",
    }
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token and parsed.hostname == "api.github.com":
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise RuntimeError(f"下载失败（{url}）：{exc}") from exc


def _parse_sha256_file(text: str, expected_name: str) -> str:
    for line in text.splitlines():
        parts = line.strip().split()
        if len(parts) >= 2 and parts[1].lstrip("*") == expected_name:
            digest = parts[0].lower()
            if re.fullmatch(r"[0-9a-f]{64}", digest):
                return digest
        elif len(parts) == 1 and re.fullmatch(r"[0-9a-f]{64}", parts[0].lower()):
            return parts[0].lower()
    raise RuntimeError(f"校验文件缺少 {expected_name} 的有效 SHA-256")


def extract_verified_bundle(archive_path: Path, expected_sha256: str, dest_dir: Path) -> Path:
    actual = hashlib.sha256(archive_path.read_bytes()).hexdigest().lower()
    if actual != expected_sha256.lower():
        raise RuntimeError(
            f"更新包 SHA-256 校验失败：期望 {expected_sha256}，实际 {actual}"
        )
    dest_resolved = dest_dir.resolve()
    with tarfile.open(archive_path, mode="r:gz") as tar:
        members = tar.getmembers()
        for member in members:
            if member.issym() or member.islnk():
                raise RuntimeError(f"拒绝解压包含链接的归档条目：{member.name}")
            target = (dest_resolved / member.name).resolve()
            if target != dest_resolved and dest_resolved not in target.parents:
                raise RuntimeError(f"拒绝解压越界路径：{member.name}")
        tar.extractall(dest_resolved)

    roots = [
        p for p in dest_resolved.iterdir()
        if p.is_dir() and (p / "orca-plugin.json").is_file()
    ]
    if len(roots) != 1:
        raise RuntimeError("更新包目录结构无效：未找到包含 orca-plugin.json 的唯一根目录")
    return roots[0]


def fetch_latest_release_bundle(
    dest_dir: Path,
    *,
    repo: str = DEFAULT_RELEASE_REPO,
    fetcher=_http_get_bytes,
) -> tuple[Path, str]:
    api_url = f"https://api.github.com/repos/{repo}/releases/latest"
    release = json.loads(fetcher(api_url).decode("utf-8"))
    tag = str(release.get("tag_name") or "").strip()
    if not tag:
        raise RuntimeError(f"无法从 {repo} 获取最新 Release 版本号")
    archive_name = f"{FULL_BUNDLE_PREFIX}{tag}.tar.gz"
    checksum_name = f"{archive_name}.sha256"
    assets = release.get("assets") or []
    archive_url = next(
        (str(a.get("browser_download_url")) for a in assets if a.get("name") == archive_name),
        None,
    )
    checksum_url = next(
        (str(a.get("browser_download_url")) for a in assets if a.get("name") == checksum_name),
        None,
    )
    if not archive_url or not checksum_url:
        raise RuntimeError(f"Release {tag} 缺少完整安装包资产（{archive_name} / {checksum_name}）")

    dest_dir.mkdir(parents=True, exist_ok=True)
    archive_path = dest_dir / archive_name
    archive_path.write_bytes(fetcher(archive_url))
    checksum_text = fetcher(checksum_url).decode("utf-8")
    expected_sha = _parse_sha256_file(checksum_text, archive_name)
    extracted = extract_verified_bundle(archive_path, expected_sha, dest_dir / "extracted")
    return extracted, tag


def refresh_installed_runtimes(
    runtime_root: Path,
    *,
    runner=run_cmd,
) -> dict | None:
    admin_script = runtime_root / "github-issue-autopilot" / "scripts" / "autopilot_admin.py"
    if not admin_script.is_file():
        return None
    res = runner([sys.executable, str(admin_script), "refresh-runtimes", "--all"])
    if res.returncode != 0:
        raise RuntimeError(
            f"刷新已安装 Autopilot runtime 失败：{res.stderr.strip() or res.stdout.strip()}"
        )
    try:
        return json.loads(res.stdout)
    except json.JSONDecodeError:
        return {"status": "refreshed", "installations": 0, "repositories": []}


def perform_install(
    source_root: Path,
    args: argparse.Namespace,
    *,
    is_update: bool = False,
) -> int:
    if args.dev:
        runtime_root = source_root.resolve()
    else:
        install_dir = Path(args.install_dir).expanduser() if args.install_dir else None
        runtime_root = install_standalone_files(source_root=source_root, install_dir=install_dir)
        action_word = "更新" if is_update else "独立安装"
        print(f"已{action_word}运行文件到：{runtime_root}")

    bin_dir = Path(args.bin_dir).expanduser() if args.bin_dir else None
    cli_script = runtime_root / "scripts" / "orca-autopilot"
    installed = install_cli(bin_dir=bin_dir, script_path=cli_script)
    installed_dir = installed[0].parent
    print("已安装终端命令：" + ", ".join(str(p) for p in installed))
    path_entries = [
        Path(p).expanduser().resolve()
        for p in os.environ.get("PATH", "").split(os.pathsep)
        if p
    ]
    if installed_dir.resolve() not in path_entries:
        print(
            f"提示：请将 {installed_dir} 加入 PATH，例如：\n"
            f'  export PATH="{installed_dir}:$PATH"'
        )

    if not args.no_skills:
        skill_dirs = [Path(p) for p in args.skills_dir] if args.skills_dir else None
        skill_results = install_skills(source_root=runtime_root, skill_dirs=skill_dirs)
        print(
            "已自动同步内置 Skill（"
            + ", ".join(MANAGED_SKILLS)
            + "）到："
            + ", ".join(str(d) for d in skill_results)
        )

    if not args.no_plugin:
        try:
            ensure_plugin_ready(
                plugin_dir=runtime_root,
                dev_mode=args.dev,
            )
            mode_label = "开发模式" if args.dev else "正式"
            print(
                f"Orca Autopilot {mode_label}插件已就绪（点击状态栏或按 Cmd+Shift+I 可在终端打开控制台）。"
            )
        except (RuntimeError, FileNotFoundError) as exc:
            print(f"提示：Orca 状态栏插件跳过（{exc}），不影响终端直接运行 `orca-autopilot`。")

    if not args.no_refresh_runtimes:
        try:
            refreshed = refresh_installed_runtimes(runtime_root)
            if refreshed and int(refreshed.get("installations") or 0) > 0:
                repos = ", ".join(refreshed.get("repositories") or [])
                print(
                    f"已刷新 {refreshed['installations']} 个仓库的 Autopilot runtime"
                    + (f"：{repos}" if repos else "")
                )
        except RuntimeError as exc:
            print(f"提示：{exc}")

    if is_update:
        new_version = read_installed_version(runtime_root)
        ver_suffix = f"（当前版本 v{new_version}）" if new_version else ""
        print(f"本机 Orca Autopilot 已全部更新完成{ver_suffix}。")
    else:
        if not args.dev:
            print("全部组件已独立安装完成，之后删除本源码/解压目录也不影响使用。")
        print("在任意项目目录直接运行 `orca-autopilot` 即可启动终端控制台。")
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="orca-autopilot",
        description="在当前终端运行 Orca Autopilot 控制台 (TUI)，支持鼠标点击与快捷键。",
    )
    parser.add_argument(
        "path",
        nargs="?",
        default=None,
        help="项目目录路径（默认使用当前工作目录）；也可传入 `update` 执行一键更新",
    )
    parser.add_argument(
        "--install",
        action="store_true",
        help="独立安装 orca-autopilot（含兼容别名 orca-board）、全部内置 Skill 及 Orca 正式插件，安装后可安全删除源码目录",
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="一键更新本机 orca-autopilot 运行文件、内置 Skill、Orca 插件与已安装的 Autopilot runtime",
    )
    parser.add_argument(
        "--from",
        dest="source_from",
        default=None,
        help="配合 --update 使用，直接从指定本地源码目录同步更新（默认从 GitHub 最新 Release 下载）",
    )
    parser.add_argument(
        "--repo",
        default=DEFAULT_RELEASE_REPO,
        help=f"配合 --update 使用，指定 GitHub Release 仓库（默认 {DEFAULT_RELEASE_REPO}）",
    )
    parser.add_argument(
        "--dev",
        action="store_true",
        help="配合 --install 使用，改用开发模式链接当前源码目录并加载 dev 插件",
    )
    parser.add_argument(
        "--no-plugin",
        action="store_true",
        help="配合 --install/--update 使用，跳过 Orca 状态栏插件安装",
    )
    parser.add_argument(
        "--no-skills",
        action="store_true",
        help="配合 --install/--update 使用，跳过内置 Agent Skill 自动安装",
    )
    parser.add_argument(
        "--no-refresh-runtimes",
        action="store_true",
        help="配合 --install/--update 使用，跳过自动刷新已安装仓库的 Autopilot runtime",
    )
    parser.add_argument(
        "--install-dir",
        default=None,
        help="配合 --install/--update 使用，指定独立安装目录（默认 ~/.local/share/orca-autopilot）",
    )
    parser.add_argument(
        "--bin-dir",
        default=None,
        help="配合 --install/--update 使用，指定命令安装目录（默认 ~/.local/bin）",
    )
    parser.add_argument(
        "--skills-dir",
        action="append",
        default=None,
        help="配合 --install/--update 使用，指定 Skill 安装目录（可重复传入；默认自动检测已安装的 Agent 运行时）",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        is_update = bool(args.update) or (
            args.path == "update" and not (Path.cwd() / "update").exists()
        )
        if is_update:
            if args.source_from:
                src = Path(args.source_from).expanduser().resolve()
                if not (src / "orca-plugin.json").is_file():
                    raise RuntimeError(f"指定的源码目录缺少 orca-plugin.json：{src}")
                return perform_install(src, args, is_update=True)
            current_ver = read_installed_version(REPO_ROOT)
            with tempfile.TemporaryDirectory(prefix="orca-autopilot-update-") as tmp:
                extracted_root, tag = fetch_latest_release_bundle(
                    Path(tmp),
                    repo=args.repo,
                )
                if current_ver:
                    print(f"正在更新 Orca Autopilot：v{current_ver} → {tag}")
                else:
                    print(f"正在更新 Orca Autopilot：{tag}")
                return perform_install(extracted_root, args, is_update=True)

        if args.install:
            return perform_install(REPO_ROOT, args, is_update=False)

        target = Path(args.path).expanduser() if args.path else Path.cwd()
        return launch_tui(target)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
